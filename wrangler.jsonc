{
  // ============================================================
  // Cloudflare Workers 설정 (정적 사이트 + 견적 접수 API)
  // ------------------------------------------------------------
  // main 브랜치에 push 하면 Cloudflare 가 `npx wrangler deploy` 를 실행한다.
  // ============================================================

  "name": "onlycartalk",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    // 배포할 폴더 — 이 안의 파일이 사이트 루트가 된다.
    "directory": "./site",
    "binding": "ASSETS",

    // 없는 주소로 들어오면 site/404.html 을 보여준다.
    "not_found_handling": "404-page",

    // /quote.html 로 들어와도 /quote 로 정리해서 보여준다.
    "html_handling": "auto-trailing-slash",

    // 견적 접수만 Worker 코드(src/index.js)가 받고, 나머지는 정적 파일 그대로.
    "run_worker_first": ["/api/*"]
  },

  // 견적 신청 메일 — Cloudflare Email Routing 으로 발송한다.
  // 받는 주소는 Email Routing 의 '대상 주소'에 인증되어 있어야 한다.
  "send_email": [
    { "name": "MAILER", "destination_address": "jdgp@jdgp.co.kr" }
  ],

  "vars": {
    "MAIL_TO": "jdgp@jdgp.co.kr",
    "MAIL_FROM": "noti@onlycartalk.com",
    "MAIL_FROM_NAME": "온니카톡 견적"
  },

  "observability": {
    "enabled": true
  }
}
